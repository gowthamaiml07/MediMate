# ==============================================================================
# MediMate Backend (.env.example)
# Rename this file to .env for local FastAPI execution.
# ==============================================================================

# General
ENVIRONMENT=development
PORT=8000
DEMO_MODE=true

# ------------------------------------------------------------------------------
# SERVER-ONLY SUPABASE CREDENTIALS (NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------

# Supabase Project API URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (used for unprivileged service requests)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SUPERUSER PRIVILEGES — BYPASSES RLS)
# Keep strictly secret on the backend server for elevated administrative actions.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase JWT Secret (Used by FastAPI to cryptographically verify user bearer tokens)
# Found in Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Expected JWT Audience claim from Supabase (default is "authenticated")
SUPABASE_AUDIENCE=authenticated

# Direct PostgreSQL Connection String for database migrations & pooled connections
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# LLM & OCR PROVIDER CONFIGURATIONS
# ------------------------------------------------------------------------------
# LLM Provider selection: "gemini" | "openai" | "groq" | "mock"
DEFAULT_LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# OCR Provider selection: "mock" | "gemini_vision" | "openai_vision"
DEFAULT_OCR_PROVIDER=mock
OCR_MODEL=gemini-1.5-flash
OCR_API_KEY=your-ocr-api-key-here

# Document Storage & Security Constraints
STORAGE_DIR=storage/prescriptions
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
SIGNED_URL_EXPIRATION_SECONDS=900 # 15 minutes

