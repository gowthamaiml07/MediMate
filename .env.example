# ==============================================================================
# MediMate AI - Root Environment Reference
# ==============================================================================

# System Mode
ENVIRONMENT=development
DEMO_MODE=true

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (.env.local in ./frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="MediMate AI"

# ------------------------------------------------------------------------------
# BACKEND SERVER-ONLY SECRETS (.env in ./backend)
# ------------------------------------------------------------------------------
PORT=8000
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_AUDIENCE=authenticated
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# AI & Conversational Assistant Providers (Step 7)
# Keep all API keys strictly on backend; never expose in frontend bundles or logs.
DEFAULT_LLM_PROVIDER=mock # "gemini" | "openai" | "groq" | "mock"
LLM_MODEL=gemini-1.5-flash # or "gpt-4o-mini", "llama-3.3-70b-versatile", "mock-medical-llm-v1"
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Medical Knowledge & Citation Base
# Authoritative public references used: MedlinePlus (NIH), FDA DailyMed, NHS Medicines A-Z, WHO
ENABLE_MEDICAL_CITATIONS=true

DEFAULT_OCR_PROVIDER=mock   # "mock" | "gemini_vision" | "openai_vision"
OCR_MODEL=gemini-1.5-flash
OCR_API_KEY=your_ocr_api_key_here

# Document Storage & Security Constraints
STORAGE_DIR=storage/prescriptions
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
SIGNED_URL_EXPIRATION_SECONDS=900

